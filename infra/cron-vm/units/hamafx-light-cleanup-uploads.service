[Unit]
Description=HamaFX-Ai light cron — delete chat-image blobs older than 7 days
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hamafx
Group=hamafx
EnvironmentFile=/opt/hamafx/.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hamafx
ExecStart=/usr/bin/curl -fsS -m 60 \
  -H "Authorization: Bearer ${CRON_SECRET}" \
  "${PRODUCTION_URL}/api/cron/cleanup-uploads"
# A missing monitoring ID must not turn a successful cleanup into a failed unit.
ExecStartPost=/bin/sh -c 'test -z "$HC_CLEANUP_UPLOADS_UUID" || /usr/bin/curl -fsS -m 5 "https://hc-ping.com/${HC_CLEANUP_UPLOADS_UUID}/0"'

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hamafx-light-cleanup-uploads
